#. module: pos_modena
#: model:ir.module.module,summary:base.module_pos_modena
msgid ""
"Pay POS orders with Modena from the customer's phone: QR code or printed "
"payment slip."
msgstr "Kassatellimuste maksmine Modenaga kliendi telefonist: QR-kood või prinditud maksetšekk."

#. module: pos_modena
#. odoo-python
#: code:addons/pos_modena/models/payment_transaction.py:0
msgid ""
"Payment %(ref)s arrived after the POS session %(session)s was closed. The "
"payment is booked as a customer payment, finish order %(order)s manually."
msgstr "Makse %(ref)s saabus pärast kassa vahetuse %(session)s sulgemist. Makse on kirjendatud kliendi maksena, lõpeta tellimus %(order)s käsitsi."

