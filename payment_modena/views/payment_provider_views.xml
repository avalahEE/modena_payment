<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Modena Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'modena'">
                    <field name="modena_client_id" required="code == 'modena'"/>
                    <field name="modena_client_secret" required="code == 'modena'" widget="password"/>
                    <field name="modena_signature_key" widget="password"/>
                    <button string="Update bank list" type="object" name="action_modena_sync_banks"
                            class="btn-secondary" colspan="2"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
