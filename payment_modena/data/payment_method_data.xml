<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_modena_slice" model="payment.method">
        <field name="name">Pay in 3</field>
        <field name="code">modena_slice</field>
        <field name="sequence">10</field>
        <field name="provider_id" ref="payment_provider_modena"/>
        <field name="image" type="bytes" file="payment_modena/static/img/modena.png"/>
        <field name="support_tokenization">False</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.ee'), ref('base.lv')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.EUR')])]"/>
    </record>

