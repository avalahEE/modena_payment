<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_modena_check_pending" model="ir.cron">
        <field name="name">Modena: check pending payments</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="code">model._cron_modena_check_pending()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="cron_modena_sync_banks" model="ir.cron">
        <field name="name">Modena: update bank list</field>
        <field name="model_id" ref="payment.model_payment_provider"/>
        <field name="code">model._cron_modena_sync_banks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
